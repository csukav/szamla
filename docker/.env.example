# Másold .env néven a docker/ mappába, és töltsd ki. A .env soha nem kerül git alá (lásd ../.gitignore).

POSTGRES_DB=szamla
POSTGRES_USER=szamla
POSTGRES_PASSWORD=changeme

# Base64-kódolt, legalább 32 bájtos (256 bites) véletlen kulcs. Generálás:
#   pwsh: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   bash: openssl rand -base64 32
JWT_SIGNING_KEY=

JWT_ISSUER=Szamla
JWT_AUDIENCE=Szamla.Client

FRONTEND_ORIGIN=http://localhost:5173

ASPNETCORE_ENVIRONMENT=Production
